  // 2. Permissions
  const seededPermissions: Record<string, string> = {};
  for (const perm of permissionsList) {
    const key = `${perm.action}:${perm.resource}${perm.scope ? "." + perm.scope : ""}`;
    const created = await prisma.permission.upsert({
      where: {
        action_resource_scope: {
          action: perm.action,
          resource: perm.resource,
          scope: perm.scope as string | null,
        },
      },
      update: { description: perm.description, category: perm.category },
      create: perm,
    });
    seededPermissions[key] = created.id;
  }
  console.log(`✅ ${Object.keys(seededPermissions).length} permissions initialisées`);

  // 3. Rôles + associations
  const seededRoles: Record<string, string> = {};
