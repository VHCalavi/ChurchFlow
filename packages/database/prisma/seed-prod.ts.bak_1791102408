    const roleObj = await prisma.role.upsert({
      where: { name: r.name },
      update: { description: r.description, isSystem: true, isDefault: r.isDefault },
      create: {
        name: r.name,
        description: r.description,
        isSystem: true,
        isDefault: r.isDefault,
        churchId: null,
      },
    });
    seededRoles[r.name] = roleObj.id;

    // Reset des permissions puis réinsertion (idempotent)
    await prisma.rolePermission.deleteMany({ where: { roleId: roleObj.id } });
    const permIds = r.perms
      .map((pKey) => seededPermissions[pKey])
      .filter(Boolean);
    if (permIds.length) {
      await prisma.rolePermission.createMany({
        data: permIds.map((pid) => ({ roleId: roleObj.id, permissionId: pid })),
        skipDuplicates: true,
      });
    }
  }
