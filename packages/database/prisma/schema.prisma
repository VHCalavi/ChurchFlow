// This is your Prisma schema file for ChurchFlow
// DB: PostgreSQL | ORM: Prisma 5

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum MemberStatus {
  SYMPATHISANT
  MEMBRE
  RESPONSABLE
}

enum MemberGrade {
  ASPIRANT
  SERVITEUR
  GAGNEUR_AMES
  ASSISTANT_PASTEUR
  PASTEUR_ASSISTANT
  PASTEUR_TITULAIRE
}

enum MemberEchelon {
  C2
  C5
  C10
  C20
  GA_C50
  GA_C100
}

enum GroupType {
  DEPARTEMENT
  TRIBU
  GEM
}

enum FormationType {
  ACADEMIE
  BAPTEME
  PORTEURS_DE_VIE
  ECOLE_DES_BERGERS
}

enum MeetingType {
  CULTE
  TEMPS_DE_PRIERE
  REPETITION
  AGAPE
  AUTRE
}

enum Gender {
  HOMME
  FEMME
}

enum MaterialStatus {
  DISPONIBLE
  EN_USAGE
  EN_REPARATION
  HORS_SERVICE
}

enum PurchaseStatus {
  DEMANDE
  APPROUVE
  COMMANDE
  RECU
  ANNULE
}

enum TransactionType {
  ENTREE
  SORTIE
}

enum TransactionCategory {
  OFFRANDE
  DIXIME
  DON
  COTISATION
  ACHAT
  PRESTATAIRE
  AUTRE
}

// ============================================================
// CHURCH (Multi-tenant)
// ============================================================

model Church {
  id          String   @id @default(cuid())
  name        String
  description String?
  address     String?
  phone       String?
  email       String?
  website     String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members      Member[]
  groups       Group[]
  formations   Formation[]
  meetings     Meeting[]
  users        User[]
  materials    Material[]
  providers    Provider[]
  purchases    Purchase[]
  transactions Transaction[]
  metadata     Json @default("{}")

  @@map("churches")
}

// ============================================================
// AUTHENTICATION & USERS
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?
  name          String?
  avatarUrl     String?
  emailVerified DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  member   Member?
  roles    UserRole[]
  sessions Session[]
  accounts Account[]
  metadata Json @default("{}")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ============================================================
// RBAC : Roles & Permissions
// ============================================================

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  action      String   // e.g. "create", "read", "update", "delete"
  resource    String   // e.g. "members", "groups", "finances"
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([action, resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ============================================================
// MEMBERS (Membres)
// ============================================================

model Member {
  id          String    @id @default(cuid())
  firstName   String
  lastName    String
  gender      Gender
  birthDate   DateTime?
  phone       String?
  email       String?
  address     String?
  photoUrl    String?
  baptismDate DateTime?
  joinDate    DateTime  @default(now())
  isActive    Boolean   @default(true)
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Hiérarchie ChurchFlow
  status   MemberStatus
  grade    MemberGrade?  // uniquement pour RESPONSABLE
  echelon  MemberEchelon? // uniquement pour RESPONSABLE

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  // Responsable hiérarchique
  supervisorId String?
  supervisor   Member?  @relation("MemberHierarchy", fields: [supervisorId], references: [id])
  subordinates Member[] @relation("MemberHierarchy")

  groups          MemberGroup[]
  formations      MemberFormation[]
  meetingsAttended MeetingAttendee[]
  metadata        Json @default("{}")

  @@map("members")
}

// ============================================================
// GROUPS (Groupes : Départements, Tribus, GEM)
// ============================================================

model Group {
  id          String    @id @default(cuid())
  name        String
  description String?
  type        GroupType
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  // GEM est un sous-groupe d'un Département ou d'une Tribu
  parentId String?
  parent   Group?  @relation("GroupHierarchy", fields: [parentId], references: [id])
  children Group[] @relation("GroupHierarchy")

  members MemberGroup[]
  metadata Json @default("{}")

  @@map("groups")
}

model MemberGroup {
  memberId  String
  groupId   String
  role      String?   // e.g. "Leader", "Membre"
  joinedAt  DateTime  @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([memberId, groupId])
  @@map("member_groups")
}

// ============================================================
// FORMATIONS (Écoles)
// ============================================================

model Formation {
  id          String        @id @default(cuid())
  name        String
  description String?
  type        FormationType
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  members MemberFormation[]

  @@map("formations")
}

model MemberFormation {
  memberId    String
  formationId String
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
  grade       String?   // Note ou mention obtenue

  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  formation Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)

  @@id([memberId, formationId])
  @@map("member_formations")
}

// ============================================================
// MEETINGS (Réunions)
// ============================================================

model Meeting {
  id          String      @id @default(cuid())
  title       String
  description String?
  type        MeetingType
  date        DateTime
  endDate     DateTime?
  location    String?
  notes       String?     @db.Text
  isRecurrent Boolean     @default(false)
  tags        String[]   @default([])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  attendees MeetingAttendee[]
  metadata  Json @default("{}")

  @@map("meetings")
}

model MeetingAttendee {
  meetingId String
  memberId  String
  isPresent Boolean?
  arrivedAt DateTime?
  notes     String?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([meetingId, memberId])
  @@map("meeting_attendees")
}

// ============================================================
// ADMINISTRATION : Matériel, Prestataires, Achats
// ============================================================

model Material {
  id           String         @id @default(cuid())
  name         String
  description  String?
  serialNumber String?
  quantity     Int            @default(1)
  status       MaterialStatus @default(DISPONIBLE)
  purchaseDate DateTime?
  purchasePrice Decimal?     @db.Decimal(12, 2)
  location     String?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@map("materials")
}

model Provider {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  specialty   String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  churchId  String
  church    Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  purchases Purchase[]

  @@map("providers")
}

model Purchase {
  id          String         @id @default(cuid())
  title       String
  description String?
  amount      Decimal        @db.Decimal(12, 2)
  status      PurchaseStatus @default(DEMANDE)
  requestDate DateTime       @default(now())
  approvedAt  DateTime?
  receivedAt  DateTime?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  churchId   String
  church     Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  providerId String?
  provider   Provider? @relation(fields: [providerId], references: [id])

  @@map("purchases")
}

// ============================================================
// FINANCES
// ============================================================

model Transaction {
  id          String              @id @default(cuid())
  title       String
  description String?
  amount      Decimal             @db.Decimal(12, 2)
  type        TransactionType
  category    TransactionCategory
  date        DateTime            @default(now())
  reference   String?
  notes       String?             @db.Text
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@map("transactions")
}
