// This is your Prisma schema file for ChurchFlow
// DB: PostgreSQL | ORM: Prisma 5

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum MemberStatus {
  SYMPATHISANT
  MEMBRE
  RESPONSABLE
}

enum MemberGrade {
  ASPIRANT
  SERVITEUR
  GAGNEUR_AMES
  ASSISTANT_PASTEUR
  PASTEUR_ASSISTANT
  PASTEUR_TITULAIRE
}

enum MemberEchelon {
  C2
  C5
  C10
  C20
  GA_C50
  GA_C100
}

enum GroupType {
  DEPARTEMENT
  TRIBU
  MAISON_D_HONNEUR
  CELLULE
  ASSEMBLEE
}

enum FormationType {
  ACADEMIE
  BAPTEME
  PORTEURS_DE_VIE
  ECOLE_DES_BERGERS
}

enum MeetingType {
  CULTE
  TEMPS_DE_PRIERE
  REPETITION
  AGAPE
  AUTRE
}

enum Gender {
  HOMME
  FEMME
}

enum MaterialStatus {
  DISPONIBLE
  EN_USAGE
  EN_REPARATION
  HORS_SERVICE
}

enum PurchaseStatus {
  DEMANDE
  APPROUVE
  COMMANDE
  RECU
  ANNULE
}

enum TransactionType {
  ENTREE
  SORTIE
}

enum ExpenseFamily {
  FONCTIONNEMENT
  INVESTISSEMENT
  EXCEPTIONNEL
}

enum PaymentMethod {
  ESPECES
  MOBILE_MONEY
  CHEQUE
  VIREMENT
}

// ============================================================
// CHURCH (Multi-tenant)
// ============================================================

model Church {
  id          String   @id @default(cuid())
  name        String
  description String?
  address     String?
  phone       String?
  email       String?
  website     String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members           Member[]
  groups            Group[]
  formations        Formation[]
  meetings          Meeting[]
  users             User[]
  materials         Material[]
  providers         Provider[]
  purchases         Purchase[]
  transactions      Transaction[]
  financeCategories FinanceCategory[]
  inactivityConfig  InactivityConfig?
  gems              Gem[]
  reports           Report[]
  metadata          Json              @default("{}")

  @@map("churches")
}

// ============================================================
// AUTHENTICATION & USERS
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?
  name          String?
  avatarUrl     String?
  emailVerified DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  member   Member?
  roles    UserRole[]
  sessions Session[]
  accounts Account[]
  metadata Json       @default("{}")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ============================================================
// RBAC : Roles & Permissions
// ============================================================

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  action      String // e.g. "create", "read", "update", "delete"
  resource    String // e.g. "members", "groups", "finances"
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([action, resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ============================================================
// MEMBERS (Membres)
// ============================================================

model Member {
  id            String    @id @default(cuid())
  firstName     String
  lastName      String
  gender        Gender
  birthDate     DateTime?
  phone         String?
  email         String?
  address       String?
  photoUrl      String?
  baptismDate   DateTime?
  joinDate      DateTime  @default(now())
  isActive      Boolean   @default(true)
  notes         String?   @db.Text
  maritalStatus String? // CELIBATAIRE, MARIE, VEUF, DIVORCE
  occupation    String? // Profession / Métier
  nationalId    String? // Numéro CNI / Passeport
  nationality   String? // Nationalité
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Hiérarchie ChurchFlow
  status  MemberStatus
  grade   MemberGrade? // uniquement pour RESPONSABLE
  echelon MemberEchelon? // uniquement pour RESPONSABLE

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  // Responsable hiérarchique
  supervisorId String?
  supervisor   Member?  @relation("MemberHierarchy", fields: [supervisorId], references: [id])
  subordinates Member[] @relation("MemberHierarchy")

  groups           MemberGroup[]
  formations       MemberFormation[]
  meetingsAttended MeetingAttendee[]
  gemMemberships   GemMember[]
  reportsWritten   Report[]          @relation("ReportAuthor")

  // Phase 1 Relations inverses (Requises par Prisma, mais non utilisées via 'include' dans le code par soucis de performance)
  interviews                MemberInterview[]
  interviewsGiven           MemberInterview[]        @relation("Interviewer")
  documents                 MemberDocument[]
  familyRelationsAsMember   FamilyRelation[]         @relation("FamilyRelationsAsMember")
  familyRelationsAsRelative FamilyRelation[]         @relation("FamilyRelationsAsRelative")
  activities                MemberActivityTimeline[]

  metadata Json @default("{}")

  @@map("members")
}

// ============================================================
// GROUPS (Groupes : Départements, Tribus, GEM)
// ============================================================

model Group {
  id          String    @id @default(cuid())
  name        String
  description String?
  type        GroupType
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  // GEM est un sous-groupe d'un Département ou d'une Tribu
  parentId String?
  parent   Group?  @relation("GroupHierarchy", fields: [parentId], references: [id])
  children Group[] @relation("GroupHierarchy")

  members  MemberGroup[]
  gems     Gem[]
  reports  Report[]
  metadata Json          @default("{}")

  @@map("groups")
}

model MemberGroup {
  memberId String
  groupId  String
  role     String? // e.g. "Leader", "Membre"
  joinedAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([memberId, groupId])
  @@map("member_groups")
}

// ============================================================
// FORMATIONS (Écoles)
// ============================================================

model Formation {
  id          String        @id @default(cuid())
  name        String
  description String?
  type        FormationType
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  members MemberFormation[]

  @@map("formations")
}

model MemberFormation {
  memberId    String
  formationId String
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
  grade       String? // Note ou mention obtenue

  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  formation Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)

  @@id([memberId, formationId])
  @@map("member_formations")
}

// ============================================================
// MEETINGS (Réunions)
// ============================================================

model Meeting {
  id          String      @id @default(cuid())
  title       String
  description String?
  type        MeetingType
  date        DateTime
  endDate     DateTime?
  location    String?
  notes       String?     @db.Text
  isRecurrent Boolean     @default(false)
  tags        String[]    @default([])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  attendees MeetingAttendee[]
  metadata  Json              @default("{}")

  @@map("meetings")
}

model MeetingAttendee {
  meetingId String
  memberId  String
  isPresent Boolean?
  arrivedAt DateTime?
  notes     String?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([meetingId, memberId])
  @@map("meeting_attendees")
}

// ============================================================
// ADMINISTRATION : Matériel, Prestataires, Achats
// ============================================================

model Material {
  id            String         @id @default(cuid())
  name          String
  description   String?
  serialNumber  String?
  quantity      Int            @default(1)
  status        MaterialStatus @default(DISPONIBLE)
  purchaseDate  DateTime?
  purchasePrice Decimal?       @db.Decimal(12, 2)
  location      String?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@map("materials")
}

model Provider {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  specialty   String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  churchId  String
  church    Church     @relation(fields: [churchId], references: [id], onDelete: Cascade)
  purchases Purchase[]

  @@map("providers")
}

model Purchase {
  id          String         @id @default(cuid())
  title       String
  description String?
  amount      Decimal        @db.Decimal(12, 2)
  status      PurchaseStatus @default(DEMANDE)
  requestDate DateTime       @default(now())
  approvedAt  DateTime?
  receivedAt  DateTime?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  churchId   String
  church     Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  providerId String?
  provider   Provider? @relation(fields: [providerId], references: [id])

  @@map("purchases")
}

// ============================================================
// FINANCES
// ============================================================

model FinanceCategory {
  id        String          @id @default(cuid())
  name      String
  flowType  TransactionType
  family    ExpenseFamily? // null pour les entrées
  color     String?
  isDefault Boolean         @default(false)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  churchId     String
  church       Church        @relation(fields: [churchId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([churchId, name, flowType])
  @@map("finance_categories")
}

model Transaction {
  id            String          @id @default(cuid())
  label         String
  amount        Decimal         @db.Decimal(12, 2)
  type          TransactionType
  expenseFamily ExpenseFamily?
  paymentMethod PaymentMethod   @default(ESPECES)
  date          DateTime        @default(now())
  donorName     String?
  reference     String?
  notes         String?         @db.Text
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  churchId   String
  church     Church           @relation(fields: [churchId], references: [id], onDelete: Cascade)
  categoryId String?
  category   FinanceCategory? @relation(fields: [categoryId], references: [id])

  @@map("transactions")
}

// ============================================================
// PHASE 1: GESTION MEMBRES & PROFIL
// ============================================================

model MemberInterview {
  id            String   @id @default(cuid())
  memberId      String
  title         String
  content       String   @db.Text
  date          DateTime @default(now())
  interviewerId String
  type          String // INITIAL, FOLLOWUP, ANNUAL, SPECIAL
  attachments   String[] // Listes d'URLs de fichiers

  member      Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  interviewer Member? @relation("Interviewer", fields: [interviewerId], references: [id])

  @@index([memberId])
  @@index([date])
  @@index([type])
  @@map("member_interviews")
}

model MemberDocument {
  id         String   @id @default(cuid())
  memberId   String
  type       String // ID_CARD, BAPTISM_CERTIFICATE, MEDICAL_REPORT, ETC.
  fileUrl    String
  fileName   String?
  uploadedAt DateTime @default(now())
  uploadedBy String // ID de l'utilisateur (User.id)

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([type])
  @@index([uploadedAt])
  @@map("member_documents")
}

model FamilyRelation {
  id           String  @id @default(cuid())
  memberId     String
  relativeId   String
  relationType String // PARENT, ENFANT, SPOUSE, SIBLING, GEM_PARTNER
  isActive     Boolean @default(true)

  member   Member @relation("FamilyRelationsAsMember", fields: [memberId], references: [id], onDelete: Cascade)
  relative Member @relation("FamilyRelationsAsRelative", fields: [relativeId], references: [id], onDelete: Cascade)

  @@unique([memberId, relativeId, relationType])
  @@index([memberId])
  @@index([relativeId])
  @@index([relationType])
  @@map("family_relations")
}

model FamilyIndex {
  id           String   @id @default(cuid())
  memberId     String
  relationType String
  relativeIds  String[]
  lastUpdated  DateTime @updatedAt

  @@index([memberId])
  @@index([relationType])
  @@map("family_indices")
}

model MemberActivityTimeline {
  id           String   @id @default(cuid())
  memberId     String
  date         DateTime
  activityType String
  details      String
  relatedId    String?
  relatedType  String?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([date])
  @@index([activityType])
  @@map("member_activity_timeline")
}

model InactivityConfig {
  id                 String   @id @default(cuid())
  name               String
  description        String?
  inactivePeriodDays Int
  actions            String[]
  isActive           Boolean  @default(true)
  churchId           String   @unique

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@map("inactivity_configs")
}

// ============================================================
// PHASE 2: GEMs & RAPPORTS
// ============================================================

model Gem {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  // Rattachement optionnel à un groupe (ex: département)
  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id])

  members GemMember[]
  reports Report[]

  @@map("gems")
}

model GemMember {
  id       String   @id @default(cuid())
  gemId    String
  memberId String
  isLeader Boolean  @default(false)
  joinedAt DateTime @default(now())

  gem    Gem    @relation(fields: [gemId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId]) // Contrainte mono-GEM — gérer via config API si multi-GEM
  @@unique([gemId, memberId])
  @@map("gem_members")
}

model Report {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  submittedAt DateTime @default(now())

  authorId String
  author   Member @relation("ReportAuthor", fields: [authorId], references: [id])

  gemId   String?
  gem     Gem?    @relation(fields: [gemId], references: [id])
  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id])

  churchId String
  church   Church @relation(fields: [churchId], references: [id])

  @@map("reports")
}
