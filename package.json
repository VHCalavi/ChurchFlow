{
  "name": "churchflow-monorepo",
  "private": true,
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:migrate": "pnpm --filter @churchflow/database db:migrate",
    "db:migrate:prod": "pnpm --filter @churchflow/database db:migrate:prod",
    "db:generate": "pnpm --filter @churchflow/database db:generate",
    "db:seed": "pnpm --filter @churchflow/database db:seed"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^1.13.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "reactflow": "^11.11.4"
  }
}
